        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Page number"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "Items per page"
        },
        "sort": {
          "type": "string",
          "enum": ["name", "-name", "createdAt", "-createdAt"],
          "default": "name",
          "description": "Sort field and direction (prefix - for desc)"
        },
        "isArchived": {
          "type": "string",
          "enum": ["active", "archived", "all"],
          "default": "all",
          "description": "Filter by archive state"
        }
      },
